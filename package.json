{
  "name": "obsidian-sticky-folders",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs --production",
    "test": "node --test tests/*.test.ts",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.13.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.1"
  },
  "description": "Obsidian plugin: pin parent folders at the top of the file explorer while scrolling.",
  "license": "MIT"
}
